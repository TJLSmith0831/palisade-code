<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime exceptions. Both exist for the llama-server sidecar:
     llama.cpp compiles Metal shaders at runtime (JIT) and loads its own
     dylibs, neither of which the default hardened runtime allows. Remove
     either one if a notarized build still runs without it. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
