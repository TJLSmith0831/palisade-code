{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Palisade",
  "version": "0.4.1",
  "identifier": "com.tjlsmith0831.palisade-code",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Palisade Code",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": true,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "llama-server"
    ],
    "resources": [
      "driver/notebook_driver.py"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0MjQ4MTE0Q0FCMDBDNjQKUldSa0RMREtGSUVrTkEvanYzaFNEanhsbFVQUk5NdUYwOENnRWtzd2hsMFU0MVJSNEUyVUpQOFQK",
      "endpoints": [
        "https://palisade-updates.tjlsmith0831.workers.dev/latest.json"
      ]
    }
  }
}
