# Bundled sidecar (build input, not source). One file per target triple plus
# the lipo'd universal one; CI builds all three, a dev machine has its own.
src-tauri/llama-server-*-apple-darwin

# Local-only, and a symlink to the main checkout in every worktree — so it
# holds build inputs only, never source. A tracked file here cannot be checked
# out in a worktree at all (git will not write through the symlink); the
# notebook driver lives in src-tauri/driver/ for exactly that reason.
src-tauri/resources

# Python bytecode from running the notebook driver self-check.
__pycache__/

# Signing/notarization secrets — see .env.example
.env

# brooks-lint run history
.brooks-lint-history.json
