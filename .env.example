# Copy to .env and fill in. Never commit .env — it's gitignored.
# Used for the signed/notarized release path (see AGENTS.md "Releasing").

# Developer ID Application cert identity, from:
#   security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY="Developer ID Application: NAME (TEAMID)"

# App Store Connect API key, from appstoreconnect.apple.com/access/integrations/api
APPLE_API_KEY=<key-id>
APPLE_API_ISSUER=<issuer-uuid>
APPLE_API_KEY_PATH=/Users/you/private_keys/AuthKey_<key-id>.p8
